{
  "name": "dots",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run wasm:build && vite",
    "wasm:build": "node scripts/build-game-core-wasm.mjs",
    "verify:source": "node scripts/verify-source-boundary.mjs",
    "build": "npm run prepare:icons && npm run verify:source && npm run wasm:build && tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "build:native": "npm run prepare:icons && npm run verify:source && tsc --noEmit && vite build && node scripts/verify-build.mjs --native",
    "preview": "vite preview",
    "test": "npm run verify:source && npm run wasm:build && vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "prepare:icons": "node scripts/prepare-icon-assets.mjs",
    "verify:dependencies": "node scripts/verify-dependency-policy.mjs",
    "verify:version": "node scripts/verify-version-consistency.mjs",
    "verify:workflows": "node scripts/verify-workflow-security.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "@tauri-apps/cli": "2.11.4"
  },
  "allowScripts": {
    "fsevents": false
  }
}
