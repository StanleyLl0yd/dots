{
  "name": "dots",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "wasm:build": "node scripts/build-game-core-wasm.mjs",
    "build": "npm run wasm:build && tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "build:native": "tsc --noEmit && vite build && node scripts/verify-build.mjs --native",
    "preview": "vite preview",
    "test": "npm run wasm:build && vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.7"
  }
}
